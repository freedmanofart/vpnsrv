# =========================
# PostgreSQL
# =========================

POSTGRES_CONTAINER=postgres
VPN_DATABASE_NAME=vpn


# =========================
# Application
# =========================

DATABASE_URL=postgresql+asyncpg://user:password@host.docker.internal:6432/vpn

LOG_LEVEL=INFO

# 3x-ui master integration. Set a base URL including the panel base path,
# for example https://panel.example.com/secret-path, and use its numeric
# inbound ID as VPN node config inbound_tag.
THREEXUI_API_TOKEN=
THREEXUI_VERIFY_TLS=true


# =========================
# Telegram
# =========================

BOT_TOKEN=change_me
TELEGRAM_CHANNEL_URL=
SUPPORT_URL=
# Пусто — показывать в боте все активные публичные тарифы из VPN API.
BOT_PLAN_CODES=
YOOMONEY_PAYMENT_URL=
YOOMONEY_14D_URL=
YOOMONEY_30D_URL=
YOOMONEY_90D_URL=
TRY_PAYMENT_URL=


# =========================
# Internal API
# =========================

API_URL=http://api:8000
SERVICE_API_TOKEN=change_me

# Mock provider keeps the test Telegram flow usable until a real provider is selected.
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=change_me
PAYMENT_AUTO_CONFIRM=true
PROMO_CODES=WELCOME7:7

# Background lifecycle jobs run in the worker service, not in every API replica.
BACKGROUND_JOBS_ENABLED=false
LIFECYCLE_INTERVAL_SECONDS=60
LIFECYCLE_ADVISORY_LOCK_KEY=846202608
WORKER_RUN_ONCE=false

VPN_PLAN_ID=1
VPN_NODE_ID=1

# Web admin: http://localhost:8000 (перенаправляет на /admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me

# Только для scripts/register_3xui_node.py; не передавайте эти значения в контейнеры.
THREEXUI_MASTER_URL=
THREEXUI_MASTER_VERIFY_TLS=true
THREEXUI_ADMIN_TOKEN=
THREEXUI_CHILD_API_TOKEN=
THREEXUI_CHILD_NAME=
THREEXUI_CHILD_ADDRESS=
THREEXUI_CHILD_BASE_PATH=
THREEXUI_INBOUND_ID=
# Не задавайте VPN_NODE_REGION для публичного IP: страна определяется автоматически.
# Ручной формат для тестовой сети: DE|Германия
VPN_NODE_REGION=
VPN_NODE_IP=
VPN_PUBLIC_HOST=
VPN_PUBLIC_PORT=
VPN_REALITY_SNI=
VPN_REALITY_PUBLIC_KEY=
VPN_REALITY_SHORT_ID=
