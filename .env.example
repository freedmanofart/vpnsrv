# =========================
# PostgreSQL
# =========================

POSTGRES_DB=vpn
POSTGRES_USER=vpn
POSTGRES_PASSWORD=change_me


# =========================
# Application
# =========================

DATABASE_URL=postgresql+asyncpg://vpn:change_me@postgres:5432/vpn

REDIS_URL=redis://redis:6379/0

LOG_LEVEL=INFO


# =========================
# Telegram
# =========================

BOT_TOKEN=change_me


# =========================
# Internal API
# =========================

API_URL=http://api:8000
SERVICE_API_TOKEN=change_me

# Mock provider keeps the test Telegram flow usable until a real provider is selected.
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=change_me
PAYMENT_AUTO_CONFIRM=true

# Background lifecycle jobs run in the worker service, not in every API replica.
BACKGROUND_JOBS_ENABLED=false
LIFECYCLE_INTERVAL_SECONDS=60
LIFECYCLE_ADVISORY_LOCK_KEY=846202608
WORKER_RUN_ONCE=false

# direct: the worker calls local Xray; agent: remote nodes pull desired state.
XRAY_MANAGEMENT_MODE=direct


VPN_PLAN_ID=1
VPN_NODE_ID=1

# Web admin: http://localhost:8000/admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me

# =========================
# Node agent (set after credential creation)
# =========================
CONTROL_PLANE_URL=http://api:8000
NODE_AGENT_NODE_ID=1
NODE_AGENT_TOKEN=
NODE_AGENT_INTERVAL_SECONDS=30

# =========================
# Grafana
# =========================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me
