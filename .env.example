# =========================
# PostgreSQL
# =========================

POSTGRES_DB=vpn
POSTGRES_USER=vpn
POSTGRES_PASSWORD=change_me


# =========================
# Application
# =========================

DATABASE_URL=postgresql+asyncpg://vpn:change_me@postgres:5432/vpn

REDIS_URL=redis://redis:6379/0

LOG_LEVEL=INFO

# 3x-ui master integration. Set a base URL including the panel base path,
# for example https://panel.example.com/secret-path, and use its numeric
# inbound ID as VPN node config inbound_tag.
THREEXUI_API_TOKEN=
THREEXUI_VERIFY_TLS=true


# =========================
# Telegram
# =========================

BOT_TOKEN=change_me
TELEGRAM_CHANNEL_URL=
SUPPORT_URL=
BOT_PLAN_CODES=vpn_14d,vpn_30d,vpn_90d
YOOMONEY_PAYMENT_URL=
YOOMONEY_14D_URL=
YOOMONEY_30D_URL=
YOOMONEY_90D_URL=
TRY_PAYMENT_URL=


# =========================
# Internal API
# =========================

API_URL=http://api:8000
SERVICE_API_TOKEN=change_me

# Mock provider keeps the test Telegram flow usable until a real provider is selected.
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=change_me
PAYMENT_AUTO_CONFIRM=true
PROMO_CODES=WELCOME7:7

# Background lifecycle jobs run in the worker service, not in every API replica.
BACKGROUND_JOBS_ENABLED=false
LIFECYCLE_INTERVAL_SECONDS=60
LIFECYCLE_ADVISORY_LOCK_KEY=846202608
WORKER_RUN_ONCE=false

VPN_PLAN_ID=1
VPN_NODE_ID=1

# Web admin: http://localhost:8000/admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me

# =========================
# Grafana
# =========================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me
