# =========================
# PostgreSQL
# =========================

POSTGRES_CONTAINER=postgres
VPN_DATABASE_NAME=vpn


# =========================
# Application
# =========================

DATABASE_URL=postgresql+asyncpg://user:password@host.docker.internal:6432/vpn

LOG_LEVEL=INFO

# 3x-ui master integration. Set a base URL including the panel base path,
# for example https://panel.example.com/secret-path, and use its numeric
# inbound ID as VPN node config inbound_tag.
THREEXUI_API_TOKEN=
THREEXUI_VERIFY_TLS=true


# =========================
# Telegram
# =========================

BOT_TOKEN=change_me
BOT_USERNAME=vpn142323srv_bot
BOT_ADMIN_CHAT_ID=0
ADMIN_NOTIFICATION_EMAIL=freedmanofart5@gmail.com
TELEGRAM_CHANNEL_URL=https://t.me/FreedomVPN_pub
SUPPORT_URL=https://t.me/Freedom_VPN_Support
# Временно можно использовать HTTPS MagicDNS-адрес Tailscale,
# например https://master.example-tailnet.ts.net/cabinet.
WEB_CABINET_URL=https://freedomvpn.taile485ac.ts.net/cabinet
WEB_SITE_URL=https://freedomvpn.taile485ac.ts.net/
# Пусто — показывать в боте все активные публичные тарифы из VPN API.
BOT_PLAN_CODES=
YOOMONEY_PAYMENT_URL=
YOOMONEY_14D_URL=
YOOMONEY_30D_URL=
YOOMONEY_90D_URL=
TRY_PAYMENT_URL=


# =========================
# Internal API
# =========================

API_URL=http://api:8000
SERVICE_API_TOKEN=change_me

# Mock provider keeps the test Telegram flow usable until a real provider is selected.
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=change_me
PAYMENT_AUTO_CONFIRM=true
PROMO_CODES=WELCOME7:7

# Background lifecycle jobs run in the worker service, not in every API replica.
BACKGROUND_JOBS_ENABLED=false
LIFECYCLE_INTERVAL_SECONDS=60
LIFECYCLE_ADVISORY_LOCK_KEY=846202608
WORKER_RUN_ONCE=false

VPN_PLAN_ID=1
VPN_NODE_ID=1

# Публичный сайт: http://localhost:8000/, web admin: http://localhost:8000/admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me

# Публичный HTTPS-адрес сайта. Также определяет флаг Secure у cookie кабинета.
PUBLIC_BASE_URL=https://freedomvpn.taile485ac.ts.net
CABINET_TOKEN_TTL_DAYS=365
CABINET_EMAIL_CODE_TTL_MINUTES=10
# Временный ручной вход без email. Отключите после настройки SMTP.
CABINET_ALLOW_TEMPORARY_REGISTRATION=false

# SMTP для отправки кодов входа в веб-кабинет. Рекомендуется внешний authenticated
# relay с подтверждённым sender/domain. SMTP_FROM обязателен вместе с SMTP_HOST.
# Для локального Postfix-smarthost: host.docker.internal:25, пустые credentials,
# STARTTLS/SSL=false; сам Postfix должен пересылать через внешний relayhost.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Freedom VPN <vpn@example.com>
SMTP_STARTTLS=true
SMTP_USE_SSL=false

# Только для scripts/register_3xui_node.py; не передавайте эти значения в контейнеры.
THREEXUI_MASTER_URL=
THREEXUI_MASTER_VERIFY_TLS=true
THREEXUI_ADMIN_TOKEN=
THREEXUI_CHILD_API_TOKEN=
THREEXUI_CHILD_NAME=
THREEXUI_CHILD_ADDRESS=
THREEXUI_CHILD_BASE_PATH=
THREEXUI_INBOUND_ID=
# Не задавайте VPN_NODE_REGION для публичного IP: страна определяется автоматически.
# Ручной формат для тестовой сети: DE|Германия
VPN_NODE_REGION=
VPN_NODE_IP=
VPN_PUBLIC_HOST=
VPN_PUBLIC_PORT=
VPN_REALITY_SNI=
VPN_REALITY_PUBLIC_KEY=
VPN_REALITY_SHORT_ID=
