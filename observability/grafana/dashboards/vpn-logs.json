{
  "annotations": {"list": []},
  "editable": true,
  "panels": [
    {
      "type": "timeseries",
      "title": "Errors by service",
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [{"expr": "sum by (service_name) (count_over_time({environment=\"staging\"} |~ `(?i)error|exception|failed` [5m]))", "refId": "A"}],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
    },
    {
      "type": "timeseries",
      "title": "Lifecycle and reconciliation events",
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [{"expr": "sum by (event_type) (count_over_time({event_type=~\"lifecycle_cycle|node_reconciliation\"} [5m]))", "refId": "A"}],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
    },
    {
      "type": "logs",
      "title": "API / bot / worker logs",
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [{"expr": "{service_name=~\"vpn-api|vpn-bot|vpn-worker|vpn-node-agent\"}", "refId": "A"}],
      "gridPos": {"h": 13, "w": 24, "x": 0, "y": 8}
    }
  ],
  "refresh": "10s",
  "schemaVersion": 41,
  "tags": ["vpn", "logs"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "timezone": "browser",
  "title": "VPN logs",
  "uid": "vpn-logs",
  "version": 1
}
