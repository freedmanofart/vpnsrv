[Unit]
Description=Reverse SSH tunnel from control plane to VPN node
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/ssh -NT -i /etc/vpn-control-tunnel/id_ed25519 -o BatchMode=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -o StrictHostKeyChecking=yes -o UserKnownHostsFile=/etc/vpn-control-tunnel/known_hosts -R 127.0.0.1:18000:127.0.0.1:8000 vpn-tunnel@159.223.22.59
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
