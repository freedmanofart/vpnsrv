[Unit]
Description=VPN node reconciliation agent
Wants=network-online.target
After=network-online.target vpn-xray.service

[Container]
ContainerName=vpn-node-agent
Image=localhost/vpn-node-agent:latest
Network=host
EnvironmentFile=/etc/vpn-node/node-agent.env
Volume=/var/log/vpn-xray:/var/log/xray:ro,z
Exec=python -m app.node_agent

[Service]
Restart=always
RestartSec=10
MemoryMax=192M

[Install]
WantedBy=multi-user.target
